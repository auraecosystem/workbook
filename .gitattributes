# Fix xBase misclassifications (.ch, .prg, .dbf)
*.ch linguist-language=C
*.prg linguist-language=Text
*.dbf linguist-vendored

# Fix SystemVerilog misclassifications (.sv)
*.sv linguist-language=Text

# Exclude auto-generated HTML reports and web output
*.html linguist-vendored

# Treat Jupyter Notebooks as documentation rather than primary source code
*.ipynb linguist-documentation

# Ignore entire directories (if applicable)
dist/* linguist-vendored
build/* linguist-vendored
docs/* linguist-documentation
