# Exclude auto-generated HTML files from language statistics
*.html linguist-vendored

# Exclude notebooks from primary language counts
*.ipynb linguist-documentation

# Reassign misclassified file extensions (e.g., .prg files)
*.prg linguist-language=Text
z# Vendor generated HTML files so they don't count as source code
*.html linguist-vendored

# Reclassify notebooks as documentation assets
*.ipynb linguist-documentation

# Reassign misidentified dataset file extensions
*.dbf linguist-language=Text
*.prg linguist-language=Text
# Stop Linguist from counting header/data files as xBase
*.ch linguist-language=C
*.prg linguist-language=Text
*.dbf linguist-vendored

# Ignore misclassified SystemVerilog files if they are not hardware code
*.sv linguist-language=Text
